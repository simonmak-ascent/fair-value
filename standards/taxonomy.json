  "clauses": [
    { "id": "IVS.103.A10", "standard": "IVS", "label": "Valuation approaches", "summary": "Market, income and cost approaches to value.", "source_ref": "source/ivs-2025.md#ivs-103-valuation-approaches" },
    { "id": "IVS.103.A20", "standard": "IVS", "label": "Income approach and DCF", "summary": "Income approach converts projected cash flows to present value; methods are DCF variations.", "source_ref": "source/ivs-2025.md#ivs-103-income-approach" },
    { "id": "IVS.103.A05", "standard": "IVS", "label": "Matrix pricing", "summary": "A comparable-transactions subset that infers a security's yield from benchmark quoted securities.", "source_ref": "source/ivs-2025.md#ivs-103-market-approach-methods" },
    { "id": "IVS.105.A10", "standard": "IVS", "label": "Valuation models", "summary": "A valuation model must be fit for purpose; characteristics of appropriate models.", "source_ref": "source/ivs-2025.md#ivs-105-valuation-models" },
    { "id": "IVS.210.A10", "standard": "IVS", "label": "Intangible asset methods", "summary": "Income-approach methods for intangibles: excess earnings (MPEEM) and relief-from-royalty.", "source_ref": "source/ivs-2025.md#ivs-210-intangible-assets" },
    { "id": "IVS.220.A10", "standard": "IVS", "label": "Non-financial liability (Bottom-Up)", "summary": "Costs to fulfil the performance obligation plus a mark-up, discounted.", "source_ref": "source/ivs-2025.md#ivs-220-non-financial-liabilities" },
    { "id": "IVS.230.A10", "standard": "IVS", "label": "Inventory top-down residual", "summary": "Selling price less remaining costs and estimated profit.", "source_ref": "source/ivs-2025.md#ivs-230-inventory" },
    { "id": "IVS.300.A10", "standard": "IVS", "label": "Depreciated replacement cost", "summary": "Replacement cost adjusted for physical/functional/external obsolescence.", "source_ref": "source/ivs-2025.md#ivs-300-plant-equipment-and-infrastructure" },
    { "id": "IVS.400.A10", "standard": "IVS", "label": "Income capitalisation", "summary": "Stabilised profit capitalised (income capitalisation method).", "source_ref": "source/ivs-2025.md#ivs-400-real-property-interests" },
    { "id": "IVS.410.A10", "standard": "IVS", "label": "Development property residual", "summary": "Residual amount after deducting anticipated costs and risk from the completed value.", "source_ref": "source/ivs-2025.md#ivs-410-development-property" },
    { "id": "IVS.500.A10", "standard": "IVS", "label": "Financial instrument valuation models", "summary": "The valuation model must be fit for use for the financial instrument being valued.", "source_ref": "source/ivs-2025.md#ivs-500-financial-instruments" },
    { "id": "IFRS.13.61", "standard": "IFRS", "label": "Valuation techniques", "summary": "Use appropriate techniques, maximising observable inputs.", "source_ref": "source/ifrs-13.md#paragraph-61" },
    { "id": "IFRS.13.62", "standard": "IFRS", "label": "Three valuation techniques", "summary": "Market approach, cost approach and income approach.", "source_ref": "source/ifrs-13.md#paragraph-62" },
    { "id": "IFRS.13.69", "standard": "IFRS", "label": "Blockage factors", "summary": "Premiums/discounts inconsistent with the unit of account (incl. a blockage factor) are not permitted.", "source_ref": "source/ifrs-13.md#paragraph-69" },
    { "id": "IFRS16.26", "standard": "IFRS16", "label": "Lease liability measurement", "summary": "Present value of lease payments at the interest rate implicit in the lease or the incremental borrowing rate.", "source_ref": "source/ifrs-16.md#paragraph-26" },
    { "id": "IAS.36.6", "standard": "IAS", "label": "Value in use", "summary": "Present value of the future cash flows expected from an asset or cash-generating unit.", "source_ref": "source/ias-36.md#paragraph-6" },
    { "id": "IAS.36.55", "standard": "IAS", "label": "Pre-tax discount rate", "summary": "The discount rate shall be a pre-tax rate reflecting current market assessments of the time value of money and asset-specific risks.", "source_ref": "source/ias-36.md#paragraph-55" },
    { "id": "IAS.36.18", "standard": "IAS", "label": "Recoverable amount", "summary": "Recoverable amount is the higher of fair value less costs of disposal and value in use.", "source_ref": "source/ias-36.md#paragraph-18" },
    { "id": "IAS.37.36", "standard": "IAS", "label": "Best estimate of a provision", "summary": "A provision is measured at the best estimate of the expenditure required to settle the present obligation.", "source_ref": "source/ias-37.md#paragraph-36" },
    { "id": "IFRS.9.5.5.5", "standard": "IFRS9", "label": "Measurement of expected credit losses", "summary": "ECL: unbiased, probability-weighted, time value of money, forward-looking.", "source_ref": "source/ifrs-9.md#paragraph-5-5-5" },
    { "id": "IFRS.17.32", "standard": "IFRS17", "label": "Fulfilment cash flows", "summary": "PV of cash flows, a financial-risk adjustment, and a risk adjustment for non-financial risk.", "source_ref": "source/ifrs-17.md#paragraph-32" },
    { "id": "IAS.19.67", "standard": "IAS19", "label": "Projected unit credit method", "summary": "Each period of service gives rise to an additional unit of benefit entitlement, measured separately.", "source_ref": "source/ias-19.md#paragraph-67" }
  ],
